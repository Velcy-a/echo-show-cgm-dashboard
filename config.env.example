# Copy to config.env, fill in, then: chmod 600 config.env
# Wrap values in single quotes if they contain spaces or $ ! " characters.

# LibreLinkUp account that has accepted an invite from the sensor wearer.
LIBRE_EMAIL='you@example.com'
LIBRE_PASSWORD='your-librelinkup-password'

# US, EU, EU2, DE, FR, AU, AP, AE, CA, JP, LA or RU. If this is wrong the
# login is redirected automatically and the log prints the right value.
LIBRE_REGION='US'

# Only needed if the account follows more than one person; the first start
# logs the available IDs.
LIBRE_PATIENT_ID=''

# Upstream poll interval in seconds (minimum 30; Abbott rate-limits faster polling).
POLL_SECONDS=60

# Alarm thresholds in mg/dL: alarm when value < LOW or value > HIGH.
GLUCOSE_LOW=70
GLUCOSE_HIGH=180

# Minutes a tap silences the alarm for.
ALARM_SNOOZE_MINUTES=15

# A reading older than this many minutes is shown greyed out as NO SIGNAL.
STALE_MINUTES=10
